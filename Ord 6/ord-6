    function shuffleFlashcards() {
      for (let i = activeList.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [activeList[i], activeList[j]] = [activeList[j], activeList[i]];
      }
      currentIndex = 0;
      renderFlashcard();
      playSoundEffect('flip');
    }

