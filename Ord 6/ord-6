          btn.className = 'btn-3d bg-white hover:bg-amber-50 border-2 border-slate-200 border-b-4 rounded-2xl p-4 font-display font-bold text-xl text-slate-800 text-center transition-all shadow-sm';
          btn.textContent = optText;
          btn.onclick = () => handleGrammarAnswer(btn, optText === q.correct, q.correct, q.audioText);
          grid.appendChild(btn);
        });
      }
    }

    function handleListeningAnswer(btnEl, isCorrect, target) {
      if (quizAnswered) return;
      const fb = document.getElementById('quiz-feedback');
      fb.classList.remove('hidden');

      if (isCorrect) {
        quizAnswered = true;
        quizScore++;
        document.getElementById('quiz-score').textContent = quizScore;
        playSoundEffect('correct');
        btnEl.classList.remove('bg-white', 'border-slate-200');
        btnEl.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');

        fb.className = 'mt-4 p-3.5 rounded-2xl text-center font-display font-bold text-lg bg-emerald-100 text-emerald-800 border-2 border-emerald-300';
        fb.textContent = `🎉 Giỏi lắm! Đúng là "${target.word}" (${target.meaning})!`;

        setTimeout(() => advanceQuiz(), 1300);
      } else {
        playSoundEffect('wrong');
        btnEl.classList.add('bg-rose-100', 'border-rose-400', 'animate-shake');
        fb.className = 'mt-4 p-3 rounded-2xl text-center font-display font-bold text-base bg-rose-100 text-rose-700 border-2 border-rose-300';
        fb.textContent = '😅 Chưa đúng rồi, bé nghe lại và thử chọn lại nhé!';
        speakText(target.word);
        setTimeout(() => btnEl.classList.remove('animate-shake'), 400);
      }
    }

    function handleGrammarAnswer(btnEl, isCorrect, correctText, fullAudio) {
      if (quizAnswered) return;
      const fb = document.getElementById('quiz-feedback');
      fb.classList.remove('hidden');

      if (isCorrect) {
        quizAnswered = true;
        quizScore++;
        document.getElementById('quiz-score').textContent = quizScore;
        playSoundEffect('correct');
        speakText(fullAudio);
        btnEl.classList.remove('bg-white', 'border-slate-200');
        btnEl.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');

        fb.className = 'mt-4 p-3.5 rounded-2xl text-center font-display font-bold text-lg bg-emerald-100 text-emerald-800 border-2 border-emerald-300';
        fb.textContent = `🌟 Chính xác! "${fullAudio}"`;

        setTimeout(() => advanceQuiz(), 1600);
      } else {
        playSoundEffect('wrong');
        btnEl.classList.add('bg-rose-100', 'border-rose-400', 'animate-shake');
        fb.className = 'mt-4 p-3 rounded-2xl text-center font-display font-bold text-base bg-rose-100 text-rose-700 border-2 border-rose-300';
        fb.textContent = '🤔 Chưa chính xác, thử chọn đáp án khác nhé!';
        setTimeout(() => btnEl.classList.remove('animate-shake'), 400);
      }
    }

    function advanceQuiz() {
      quizIndex++;
      if (quizIndex < quizQuestions.length) {
        renderQuizQuestion();
      } else {
        showQuizResults();
      }
    }

    function showQuizResults() {
      document.getElementById('quiz-active-area').classList.add('hidden');
      document.getElementById('quiz-result-area').classList.remove('hidden');
      document.getElementById('final-score-text').textContent = `${quizScore} / ${quizQuestions.length}`;

      const starsCount = Math.max(1, Math.round((quizScore / quizQuestions.length) * 5));
      document.getElementById('result-stars').textContent = '⭐'.repeat(starsCount);
      playSoundEffect('correct');
      launchConfetti();
    }

    function restartQuiz() {
      initQuiz();
    }

    // =========================================================================
    // 6. GRAMMAR SUMMARY RENDERER
    // =========================================================================
    function renderGrammarCards() {
      const container = document.getElementById('grammar-cards-container');
      container.innerHTML = '';

      GRAMMAR_PATTERNS.forEach(item => {
        const card = document.createElement('div');
        card.className = `rounded-3xl p-5 border-3 border-2 shadow-md flex flex-col justify-between ${item.color}`;

        const examplesHtml = item.examples.map(ex => `
          <div class="bg-white rounded-2xl p-3 border border-slate-200/80 flex items-center justify-between gap-2 shadow-xs">
            <div>
              <div class="font-display font-bold text-slate-800 text-base">${ex.en}</div>
              <div class="text-xs font-semibold text-slate-500">${ex.vi}</div>
            </div>
            <button onclick="speakText('${ex.en.replace(/'/g, "\\'")}')"
              class="btn-3d shrink-0 w-10 h-10 rounded-xl bg-sky-500 hover:bg-sky-600 text-white flex items-center justify-center text-lg shadow-sm border-b-2 border-sky-700"
              title="Nghe phát âm">
              🔊
            </button>
          </div>
        `).join('');

        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <h3 class="font-display font-bold text-lg text-slate-800">${item.title}</h3>
              <span class="shrink-0 bg-white text-slate-700 text-xs font-extrabold px-2.5 py-1 rounded-full border border-slate-200">
                ${item.badge}
              </span>
            </div>
            <div class="bg-white/90 rounded-xl px-3 py-2 font-display font-bold text-sm text-indigo-700 border border-indigo-100 mb-2">
              ${item.formula}
            </div>
            <p class="text-xs font-semibold text-slate-600 mb-3">💡 ${item.note}</p>
          </div>
          <div class="space-y-2">
            ${examplesHtml}
          </div>
        `;

        container.appendChild(card);
      });
    }

    // =========================================================================
    // 7. CONFETTI CELEBRATION EFFECT
    // =========================================================================
    function launchConfetti() {
      const canvas = document.getElementById('confetti-canvas');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const colors = ['#f43f5e', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'];
      const pieces = Array.from({ length: 90 }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height - canvas.height,
        w: Math.random() * 10 + 6,
        h: Math.random() * 6 + 4,
        color: colors[Math.floor(Math.random() * colors.length)],
        vy: Math.random() * 3 + 2.5,
        vx: Math.random() * 2 - 1,
        rot: Math.random() * 360
      }));

      let frames = 0;
      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach(p => {
          p.y += p.vy;
          p.x += p.vx;
          p.rot += 4;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rot * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });
        frames++;
        if (frames < 150) {
          requestAnimationFrame(draw);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      draw();
    }

    // Keyboard arrow shortcuts for desktop classroom teaching
    document.addEventListener('keydown', (e) => {
      const fcVisible = !document.getElementById('section-flashcards').classList.contains('hidden');
      if (!fcVisible) return;
      if (e.key === 'ArrowRight') nextCard();
      if (e.key === 'ArrowLeft') prevCard();
      if (e.key === ' ') {
        e.preventDefault();
        flipCard();
      }
    });

    // Initialize App on Load
    window.addEventListener('DOMContentLoaded', () => {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.getVoices();
      }
      renderFlashcard();
      renderGrammarCards();
    });
  </script>
